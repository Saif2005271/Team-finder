# ─── TeamFinder environment variables ───────────────────────────────
# Copy this file to `.env` and fill in the values you need.
# Anything left commented uses the default shown.

# ── Database ────────────────────────────────────────────────────────
# Pick a backend. If unset, the app defaults to SQLite (./teamfinder.db),
# which is the easiest path for local testing.
#
#   DB_BACKEND=sqlite       (default if DB_HOST is also unset)
#   DB_BACKEND=mysql
#
# When DB_BACKEND=mysql, the following are required:
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=teamfinder
#
# Optional: override SQLite file path
# SQLITE_PATH=teamfinder.db

# ── Auth ────────────────────────────────────────────────────────────
# Change this to a long random string in production.
SECRET_KEY=teamfinder_dev_secret_change_me

# Comma-separated list of accepted email domains for registration.
# Defaults shown below if unset.
# ACCEPTED_EMAIL_DOMAINS=ju.edu.jo,gmail.com,yahoo.com,outlook.com,hotmail.com

# ── Advisor (optional) ──────────────────────────────────────────────
# If unset, the advisor uses a built-in rule-based fallback.
# ANTHROPIC_API_KEY=
# ADVISOR_MODEL=claude-sonnet-4-20250514
