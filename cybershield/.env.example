# CyberShield Privacy Auditor - Environment Variables
# Copy this file to .env and fill in your API keys

# HaveIBeenPwned API Key (required for email breach checks)
# Get one at: https://haveibeenpwned.com/API/Key
HIBP_API_KEY=your_hibp_api_key_here

# VirusTotal API Key (optional, enhances phishing detection)
# Get one at: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=your_virustotal_key_here

# Server configuration
HOST=0.0.0.0
PORT=8000
